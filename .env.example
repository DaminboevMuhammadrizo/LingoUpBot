# --- required ---
# @BotFather -> /newbot
BOT_TOKEN=123456:ABC...
# https address of this server (domain behind Cloudflare/nginx)
WEBAPP_URL=https://app.example.uz/

# --- admins ---
# Telegram IDs of admins, comma separated (find yours with @userinfobot)
ADMIN_IDS=123456789
# where new users, support messages and donation checks arrive: a group id (-100...) or an admin id.
# empty = the first admin
ADMIN_CHAT_ID=

# --- Telegram as storage ---
# private channel where the bot keeps the database copy and the pictures (bot must be an admin there)
STORAGE_CHAT_ID=-100...
# telegram = pictures are served from Telegram file_id (local files only as fallback); local = public/img
MEDIA_SOURCE=telegram

# --- web server / memory (pm2 sets these too, see ecosystem.config.cjs) ---
PORT=3000
CACHE_MAX_MB=400
DISK_CACHE_MAX_MB=2048
RSS_SOFT_MB=700
